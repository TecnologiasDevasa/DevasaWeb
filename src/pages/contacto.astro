---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto | Tecnologias Devasa">
    <main class="bg-gray-950 text-white font-sans antialiased">
        <header class="relative aurora min-h-[40vh] flex flex-col items-center justify-center px-8 overflow-hidden border-b border-gray-900 text-center">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f293710_1px,transparent_1px),linear-gradient(to_bottom,#1f293710_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
            <span class="z-10 relative text-blue-500 font-semibold tracking-wider uppercase text-sm bg-blue-950/50 px-3 py-1 rounded-full border border-blue-900/50 mb-6">Hablemos</span>
            <h1 class="z-10 relative text-5xl md:text-6xl font-extrabold mb-6 leading-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-gray-200 to-gray-400">Contacto</h1>
            <p class="z-10 relative text-lg text-gray-400 max-w-2xl">Cuéntanos tu desafío y construimos la solución juntos.</p>
        </header>

        <!-- SECCION DE CONTACTO -->
        <section class="py-24 px-8 bg-gray-950">
            <div class="max-w-2xl mx-auto">
                <div class="flex items-center gap-3 mb-8">
                    <div class="h-px w-8 bg-blue-500"></div>
                    <span class="text-blue-500 text-xs uppercase tracking-wider">Formulario de Contacto</span>
                </div>
                <form action="https://formspree.io/f/mbdbjrqp" method="POST" class="space-y-6">
                    <input type="hidden" name="_next" value="https://devasa.cl/contacto" />
                    <div class="flex flex-col sm:flex-row gap-4">
                        <div class="flex-1 flex flex-col gap-2">
                            <label class="text-sm text-gray-400">Nombre *</label>
                            <input type="text" name="nombre" required class="bg-gray-900 border border-gray-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-600 transition" />
                        </div>
                        <div class="flex-1 flex flex-col gap-2">
                            <label class="text-sm text-gray-400">Apellido *</label>
                            <input type="text" name="apellido" required class="bg-gray-900 border border-gray-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-600 transition" />
                        </div>
                    </div>
                    <div class="flex flex-col gap-2">
                        <label class="text-sm text-gray-400">Razón Social</label>
                        <input type="text" name="razon_social" class="bg-gray-900 border border-gray-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-600 transition" />
                    </div>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <div class="flex-1 flex flex-col gap-2">
                            <label class="text-sm text-gray-400">Teléfono *</label>
                            <input type="tel" name="telefono" required class="bg-gray-900 border border-gray-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-600 transition" />
                        </div>
                        <div class="flex-1 flex flex-col gap-2">
                            <label class="text-sm text-gray-400">Email *</label>
                            <input type="email" name="email" required class="bg-gray-900 border border-gray-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-600 transition" />
                        </div>
                    </div>
                    <div class="flex flex-col gap-2">
                        <label class="text-sm text-gray-400">Motivo *</label>
                        <select name="motivo" required class="bg-gray-900 border border-gray-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-600 transition">
                            <option value="">Selecciona un motivo</option>
                            <option value="desarrollo">Desarrollo de Software</option>
                            <option value="asesoria">Asesoría Tecnológica</option>
                            <option value="procesos">Análisis de Procesos</option>
                            <option value="otro">Otro</option>
                        </select>
                    </div>
                    <div class="flex flex-col gap-2">
                        <label class="text-sm text-gray-400">Detalle *</label>
                        <textarea name="detalle" required rows="5" class="bg-gray-900 border border-gray-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-blue-600 transition resize-none"></textarea>
                    </div>
                    <button type="submit" class="w-full bg-blue-600 text-white py-4 rounded-xl hover:bg-blue-500 transition-colors font-medium text-lg">Enviar mensaje</button>
                </form>
            </div>
        </section>
    </main>
</Layout>